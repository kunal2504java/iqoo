# OpenRouter — all AI calls go through the backend, never the client.
# Get the key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Vision model — note/poster scan. MUST be vision-capable (OCR of handwritten Hindi/English).
# Cheap & strong: qwen/qwen2.5-vl-72b-instruct, qwen/qwen3-vl-32b-instruct, minimax/minimax-01
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct

# Text model — Ghost Senior chat. Cheap & capable: qwen/qwen3-235b-a22b-2507
OPENROUTER_TEXT_MODEL=qwen/qwen3-235b-a22b-2507

# Without a key the server serves the built-in fallback enrichment (app still works for a dry run).

# RumiK TTS — voice notes (gender-specific via the mulberry model). https://playground.rumik.ai
# Without a key, voice notes still post but no audio is synthesized.
RUMIK_API_KEY=

# Port the API listens on (binds 0.0.0.0 so the phone can reach it over the LAN).
PORT=4000

# Hard timeout (ms) for the live note-enrichment call before the fallback fires on stage.
QUAD_AI_TIMEOUT_MS=18000
